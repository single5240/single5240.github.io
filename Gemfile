source "https://rubygems.org"

gem "jekyll", "~> 3.10"
gem "jekyll-feed", "~> 0.17"
gem "kramdown-parser-gfm", "~> 1.1"
gem "csv"
gem "logger"
gem "base64"
gem "bigdecimal"
gem "drb"
gem "webrick", "~> 1.8"

# Windows does not ship the zoneinfo database Jekyll needs for site.timezone.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end
