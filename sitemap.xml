---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
  </url>
  {% assign new_pages = '/articles/index.html,/tools/index.html,/daily/index.html,/about/index.html,/topics/mcu.html,/topics/linux.html,/topics/qt.html,/topics/industrial.html' | split: ',' %}
  {% for path in new_pages %}
  <url><loc>{{ path | absolute_url }}</loc></url>
  {% endfor %}
  {% assign sitemap_pages = site.articles %}
  {% for item in sitemap_pages %}
  <url>
    <loc>{{ item.url | absolute_url }}</loc>
    {% if item.date %}<lastmod>{{ item.date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% endfor %}
  <url>
    <loc>{{ '/english/index.html' | absolute_url }}</loc>
  </url>
  {% assign english_pages = site.english | sort: "day" %}
  {% for item in english_pages %}
  <url>
    <loc>{{ item.url | absolute_url }}</loc>
    {% if item.date %}<lastmod>{{ item.date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% endfor %}
  <url>
    <loc>{{ '/projects/index.html' | absolute_url }}</loc>
  </url>
  <url>
    <loc>{{ '/projects/n32g455-tensile/index.html' | absolute_url }}</loc>
  </url>
  <url>
    <loc>{{ '/projects/my-skills/index.html' | absolute_url }}</loc>
  </url>
  <url>
    <loc>{{ '/projects/retro-robot/index.html' | absolute_url }}</loc>
  </url>
  {% assign skill_pages = site.skills | sort: "order" %}
  {% for item in skill_pages %}
  <url>
    <loc>{{ item.url | absolute_url }}</loc>
  </url>
  {% endfor %}
  <url>
    <loc>{{ '/ai-news/index.html' | absolute_url }}</loc>
  </url>
  {% for week in site.data.ai_news.weeks %}
    {% for day in week.days %}
  <url>
    <loc>{{ '/ai-news/' | append: day.date | append: '.html' | absolute_url }}</loc>
    <lastmod>{{ day.date }}</lastmod>
  </url>
    {% endfor %}
  {% endfor %}
</urlset>
